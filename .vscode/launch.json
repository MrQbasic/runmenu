{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Runmenu",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceRoot}/runmenu",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build Runmenu"
    }
  ]
}